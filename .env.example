# Local development settings. Copy to .env before starting Docker Compose.
POSTGRES_DB=tasty_screen
POSTGRES_USER=tasty_screen
POSTGRES_PASSWORD=tasty_screen_local
# Change this if another PostgreSQL instance already uses port 5432.
POSTGRES_PORT=5432

# Linux/WSL user IDs for files created through the development bind mount.
# Check with `id -u` and `id -g`; change these if your IDs differ.
LOCAL_UID=1000
LOCAL_GID=1000
